---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../consts";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/projects.json";
import analyses from "../data/analyses.json";
import designDocs from "../data/design-docs.json";

const featuredOrder = [
  "serious-jelly-battle",
  "no-orcs-system-analysis",
  "wm9m6-card-strategy-demo",
  "total-war-expansion-plan",
  "level2-gas-fps-demo"
];
const portfolioItems = [...projects, ...analyses, ...designDocs].sort((a, b) => {
  const aIndex = featuredOrder.indexOf(a.slug);
  const bIndex = featuredOrder.indexOf(b.slug);
  return (aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex)
    - (bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex);
});
---

<BaseLayout>
  <section class="hero panel">
    <div>
      <p class="eyebrow">Game Design Portfolio</p>
      <h1>{siteConfig.name}</h1>
      <p class="bio">
        华威大学游戏工程硕士，专注于游戏系统策划、战斗玩法与关卡体验设计。
        擅长从核心循环、规则结构和反馈体验出发完成方案设计，并使用 UE5 与 C++ 制作和验证玩法原型。
      </p>
      <div class="hero-links">
        <a href={siteConfig.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href={siteConfig.bilibiliUrl} target="_blank" rel="noreferrer">Bilibili</a>
      </div>
    </div>
    <div class="hero-note">
      <p class="eyebrow">Design Focus</p>
      <p class="section-copy">
        本页面展示我的游戏策划案、系统拆解与可玩原型，重点呈现核心玩法、系统规则、
        数值框架、玩家体验以及从设计到实现验证的完整过程。
      </p>
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <p class="eyebrow">Selected Works</p>
      <h2 class="section-title">Game Design & Prototype Works</h2>
      <p class="section-copy">
        这里汇总完整策划案、系统拆解和玩法原型，也保留能够体现技术理解与落地能力的开发作品。
        每项内容会说明设计目标、核心机制、体验取舍或实现方式。
      </p>
    </div>

    <div class="project-grid">
      {portfolioItems.map((item) => <ProjectCard {...item} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 1.5rem;
    padding: clamp(1.4rem, 4vw, 2.6rem);
    align-items: end;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 8vw, 5.5rem);
    line-height: 0.95;
  }

  .bio {
    margin: 1rem 0 0;
    max-width: 34rem;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .hero-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.8rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(102, 179, 255, 0.24);
    background: linear-gradient(180deg, rgba(102, 179, 255, 0.18), rgba(102, 179, 255, 0.08));
    color: var(--text);
    font-weight: 700;
  }

  .hero-note {
    padding: 1.2rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(8, 18, 33, 0.8), rgba(19, 40, 67, 0.65));
  }

  .home-section {
    margin-top: 2rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .hero,
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
