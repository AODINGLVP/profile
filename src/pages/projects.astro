---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/projects.json";
import analyses from "../data/analyses.json";
import designDocs from "../data/design-docs.json";

const featuredOrder = [
  "serious-jelly-battle",
  "no-orcs-system-analysis",
  "wm9m6-card-strategy-demo",
  "total-war-expansion-plan",
  "level2-gas-fps-demo"
];
const portfolioItems = [...projects, ...analyses, ...designDocs].sort((a, b) => {
  const aIndex = featuredOrder.indexOf(a.slug);
  const bIndex = featuredOrder.indexOf(b.slug);
  return (aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex)
    - (bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex);
});
---

<BaseLayout title="作品列表 | 游戏策划作品集">
  <section class="section-heading">
    <p class="eyebrow">Selected Works</p>
    <h1 class="section-title">Game Design & Prototype Works</h1>
    <p class="section-copy">
      本页面汇总游戏策划案、系统拆解、玩法原型与相关开发作品。每项内容重点展示设计目标、
      核心循环、规则与数值框架、体验分析，以及必要的实现验证。
    </p>
  </section>

  <section class="project-grid">
    {portfolioItems.map((item) => <ProjectCard {...item} />)}
  </section>
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
