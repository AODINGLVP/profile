---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/projects.json";
import analyses from "../data/analyses.json";
import designDocs from "../data/design-docs.json";

const featuredOrder = [
  "serious-jelly-battle",
  "no-orcs-system-analysis",
  "wm9m6-card-strategy-demo",
  "total-war-expansion-plan",
  "level2-gas-fps-demo"
];
const portfolioItems = [...projects, ...analyses, ...designDocs].sort((a, b) => {
  const aIndex = featuredOrder.indexOf(a.slug);
  const bIndex = featuredOrder.indexOf(b.slug);
  return (aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex)
    - (bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex);
});
---

<BaseLayout title="项目列表 | 游戏开发作品集">
  <section class="section-heading">
    <p class="eyebrow">Projects</p>
    <h1 class="section-title">Game Development & Design Works</h1>
    <p class="section-copy">
      本页面汇总游戏开发、系统设计和图形技术相关作品。每项作品包含技术实现、核心功能、设计分析、
      代码仓库或演示视频等详细内容。
    </p>
  </section>

  <section class="project-grid">
    {portfolioItems.map((item) => <ProjectCard {...item} />)}
  </section>
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
